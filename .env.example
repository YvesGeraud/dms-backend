NODE_ENV=development
PORT=3000
UPLOAD_BASE_PATH="uploads"
API_URL="http://localhost:3000"
#HOST=/app/dms/
HOST=/

# CORS — frontend Angular
ALLOWED_ORIGINS=http://localhost:4200

# Base de datos
DB_HOST=localhost
DB_PORT=3306
DBNAMES=dms
DB_USER=root
DB_PASSWORD=root
DATABASE_URL="mysql://root:root@localhost:3306/dms"

# JWT
JWT_SECRET=secreto_para_JWT
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=otro_secreto_diferente_para_refresh
JWT_REFRESH_EXPIRES_IN=7d



# Bcrypt
BCRYPT_ROUNDS=12

# Storage (Linode Object Storage)
STORAGE_PROVIDER=local
AWS_REGION=us-lax
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=

AWS_S3_FORCE_PATH_STYLE=true