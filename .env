# Configuración del servidor
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
# CORS - Orígenes permitidos (separados por comas)
CORS_ORIGINS_DEV=http://localhost:4200,http://localhost:3000
CORS_ORIGINS_PROD=https://yourdomain.com
# Base de datos
DB_HOST=localhost
DB_PORT=3306
DBNAMES=dms
DB_USER=root
DB_PASSWORD=root
# Construir URL de conexión automáticamente
#DATABASE_URL=
#DATABASE_URL=mysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DBNAMES}
DATABASE_URL=mysql://root:root@localhost:3306/dms
# Prefijo para rutas
HOST=/
# JWT
JWT_SECRET=tu_secreto_super_seguro_aqui
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Bcrypt
BCRYPT_ROUNDS=12
# Archivos
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_IMAGES=jpg,jpeg,png,gif,webp
ALLOWED_DOCUMENTS=pdf,doc,docx
# Correos (opcional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=Mi Aplicación
# Logging
LOG_LEVEL=debug
LOG_FILE=./logs/app.log
# Monitoreo del pool
ENABLE_POOL_MONITORING=true
POOL_MONITORING_INTERVAL=60000